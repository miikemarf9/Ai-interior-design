# Server-side only. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-6-luna

# Dedicated Neon/Postgres catalogue (Stage 5+).
# Keep this server-side. Never expose the connection string in browser code.
DATABASE_URL=

# Catalogue import admin protection.
# Use a long random value and keep it server-side.
CATALOG_IMPORT_SECRET=

# Awin Create-a-Feed download URLs.
# These URLs contain Awin feed credentials and must remain server-side.
# Generate UK English CSV feeds with comma delimiters and no compression,
# filtered to the living-room/home categories you actually want to ingest.
AWIN_FEED_URL_WAYFAIR_UK=
AWIN_FEED_URL_THE_RANGE=
