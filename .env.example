# Server-side only. Do not commit real secrets.
OPENAI_API_KEY=
OPENAI_BRIEF_MODEL=gpt-6-luna

# Stage 7 image editing. Pinned snapshot for reproducible renders.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_IMAGE_QUALITY=high

# Stage 11 visual comparison. GPT-5.6 accepts multiple image inputs through Responses API.
OPENAI_VERIFICATION_MODEL=gpt-5.6

# Verified accounts are live in Stage 10. Keep this false on public deployments.
# true is only for private/local testing of pre-account render flows.
RENDER_ALLOW_DEVELOPMENT_WALLETS=false

# Dedicated Neon/Postgres catalogue (Stage 5+).
# Keep this server-side. Never expose the connection string in browser code.
DATABASE_URL=

# Catalogue import admin protection.
# Use a long random value and keep it server-side.
CATALOG_IMPORT_SECRET=

# Awin Create-a-Feed download URLs.
# These URLs contain Awin feed credentials and must remain server-side.
# Generate UK English CSV feeds with comma delimiters and no compression,
# filtered to the living-room/home categories you actually want to ingest.
AWIN_FEED_URL_WAYFAIR_UK=
AWIN_FEED_URL_THE_RANGE=

# Stage 9 affiliate commerce. Server-side only.
# Configure after the Roomfound Awin publisher account is active.
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Protects Awin programme/transaction sync and internal commerce metrics.
COMMERCE_SYNC_SECRET=

# Stage 10 account email verification / password reset.
# Resend supports a send-only API key. AUTH_FROM_EMAIL must use a verified sender/domain.
APP_URL=
RESEND_API_KEY=
AUTH_FROM_EMAIL=

# Roomfound -> Grab&Book CRM bridge.
# The Roomfound outbox is live; direct sync remains dormant until Grab&Book exposes an authenticated ingestion endpoint.
CRM_SYNC_SECRET=
GRABANDBOOK_CRM_ENDPOINT=
GRABANDBOOK_BRIDGE_SECRET=

# Stage 12 growth engine.
# Set the canonical public origin, e.g. https://roomfound.co.uk, before indexing.
NEXT_PUBLIC_SITE_URL=

# Protects editorial publication and abandoned-design scanner endpoints.
GROWTH_ADMIN_SECRET=
GROWTH_CRON_SECRET=
GROWTH_ABANDONED_HOURS=48

# Stage 13 controlled UK beta security + launch gates.
# Use long random secrets. Do not reuse values between settings.
AUTH_RATE_LIMIT_SECRET=
BETA_ADMIN_SECRET=
PRIVACY_RETENTION_CRON_SECRET=

# Controlled access: existing accounts can sign in, new signups need the beta code.
BETA_CONTROLLED_ACCESS=true
NEXT_PUBLIC_BETA_CONTROLLED_ACCESS=true
BETA_SIGNUP_CODE=

# Commercial launch thresholds.
BETA_MIN_SELECTABLE_PRODUCTS=100
BETA_REQUIRE_AFFILIATE=true

# Render failure containment and comparable unit economics.
OPENAI_IMAGE_TIMEOUT_MS=150000
# Operating USD -> GBP rate used only to snapshot AI cost into pence.
# Refresh deliberately when your finance/ops rate changes.
AI_COST_USD_TO_GBP_RATE=

# Public compliance/contact settings.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Leave false until the beta Privacy/Terms/affiliate disclosures receive final UK review.
LEGAL_REVIEW_COMPLETE=false
